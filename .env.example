# ============================================================================
# Copy to `.env` and edit. Every value is optional — the defaults run locally.
#   cp .env.example .env
# ============================================================================

# ── server ──────────────────────────────────────────────────────────────────
IC_HOST=127.0.0.1
IC_PORT=8000
IC_LOG_LEVEL=INFO
IC_CORS_ORIGINS=*                 # comma separated list, e.g. http://localhost:5173

# ── database ────────────────────────────────────────────────────────────────
# SQLite (default, zero setup):
IC_DATABASE_URL=sqlite:///./data/app.db
# PostgreSQL (optional):
# IC_DATABASE_URL=postgresql+psycopg://faceid:secret@localhost:5432/faceid

# ── model + decision policy ─────────────────────────────────────────────────
IC_MODEL_PATH=./models/model.pkl
IC_DEMO_MODEL_PATH=./models/demo_model.pkl
IC_CONFIDENCE_THRESHOLD=0.55      # below this the answer is "Unknown"
IC_MIN_MARGIN=0.12                # top-2 gap required to accept a match
IC_MIN_SIMILARITY=0.28            # embedding-mode guard

# ── ML engine (also used as defaults for training) ──────────────────────────
IC_DETECTOR=auto                  # auto | yunet | haar
IC_EXTRACTOR=auto                 # auto | hog_lbp | sface | pixel
IC_CLASSIFIER=svc                 # svc | logistic | rf | knn
IC_AUGMENT_PER_IMAGE=6
IC_PCA_COMPONENTS=0               # 0 = keep the full descriptor
IC_TEST_SIZE=0.25
IC_CROSS_VALIDATE=1
IC_SEED=2026

# ── datasets ────────────────────────────────────────────────────────────────
IC_DATASET_DIR=./dataset
IC_DEMO_DATASET_DIR=./dataset_demo
IC_DEMO_ENABLED=1                 # ship/allow the fictional demo personas
IC_AUTO_BOOTSTRAP=1               # build + train the demo automatically when no model exists

# ── uploads ─────────────────────────────────────────────────────────────────
IC_DATA_DIR=./data
IC_UPLOAD_DIR=./data/uploads
IC_STORE_UPLOADS=1                # 0 = do not persist uploaded images / face crops
IC_MAX_UPLOAD_MB=12

# ── training endpoint protection ────────────────────────────────────────────
# Set BOTH values for any non-local deployment. With IC_ALLOW_UNSIGNED_TRAINING=0
# every POST /api/train (and /api/model/activate) call must send X-API-Key.
IC_TRAIN_API_KEY=change-me-in-production
IC_ALLOW_UNSIGNED_TRAINING=1
